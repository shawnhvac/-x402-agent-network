# MUSKOX x402 Agent Network - Environment Variables

# Server
PORT=3001
NODE_ENV=development

# Treasury (Multisig Wallet - Shawn controls)
TREASURY_WALLET=0x[your-multisig-address]
PLATFORM_FEE_PERCENT=2

# Database (PostgreSQL - Days 3-4 ACTIVE)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/x402_agents
# Or use local socket:
# DATABASE_URL=postgresql:///x402_agents

# RPC Endpoints
ETH_RPC=https://eth-mainnet.alchemyapi.io/v2/[key]
POLYGON_RPC=https://polygon-mainnet.g.alchemy.com/v2/[key]
BASE_RPC=https://base-mainnet.g.alchemy.com/v2/[key]
SOLANA_RPC=https://api.mainnet-beta.solana.com

# Agent Wallets (Demo agents)
GRID_TRADER_WALLET=0x[grid-trader-address]
SNIPER_BOT_WALLET=0x[sniper-bot-address]
