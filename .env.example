# AgentPay — Environment Variables
# Copy to .env and fill in values

# ── Required ──────────────────────────────────────────────────────────────
ADMIN_PASSWORD=your-admin-password

# ── Blockchain (Base L2) ──────────────────────────────────────────────────
# Treasury wallet private key (for on-chain USDC settlement)
TREASURY_PRIVATE_KEY=

# Your Base L2 wallet address
TREASURY_ADDRESS=0xYOUR_WALLET

# USDC contract on Base L2 (do not change)
USDC_CONTRACT=0x833589fcd6edb6e08f4c7c32d4f71b54bda02913

# ── AgentWorld Integration ────────────────────────────────────────────────
AGENTWORLD_DB=/var/lib/agentworld/world.db

# ── Notifications ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Firebase Cloud Messaging (for push notifications)
FIREBASE_SERVER_KEY=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# ── Email ─────────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_FROM=shawn@x402-agent-pay.com

# ── Security ──────────────────────────────────────────────────────────────
# Secret for cron job authentication
AGENTPAY_CRON_SECRET=your-cron-secret

# Relay secret (for grokRelay integration)
RELAY_SECRET=
